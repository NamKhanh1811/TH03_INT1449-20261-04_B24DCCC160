<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvIconDanhMucChiTiet"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_danh_muc"
            android:gravity="center"
            android:text="🍔"
            android:textSize="32sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTenKhoanChiChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvSoTienChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-30.000 đ"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FF6B6B"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh mục"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDanhMucChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ăn uống"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngày chi tiêu"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNgayChiTieuChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="16/10/2026"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú"
                    android:textColor="#999999"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvGhiChuChiTiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="(Không có ghi chú)"
                    android:textColor="#222222"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuayLai"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Quay lại"
                android:textColor="#6C63FF"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="#6C63FF"
                app:strokeWidth="2dp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXoaKhoanChi"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Xóa khoản chi"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
